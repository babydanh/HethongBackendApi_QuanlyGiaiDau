    "seed:test": "npx ts-node src/database/seeds/seed-test.ts",
    "seed:brackets": "npx ts-node src/database/seeds/generate-brackets.ts",
    "seed:play": "npx ts-node src/database/seeds/play-matches.ts",
    "seed:data": "npx ts-node src/database/seeds/seed-data-prod.ts",
    "seed:hide-banner": "npx ts-node src/database/seeds/seed-hide-banner-tournaments.ts",
    "repair:hide-banner": "npx ts-node src/database/seeds/repair-hide-banner-seed.ts",
    "repair:brackets": "npx ts-node src/database/seeds/repair-double-elim-brackets.ts",
    "seed:clear": "npx ts-node src/database/seeds/clear-tournaments.ts",
    "seed:standings-recompute": "npx ts-node src/database/seeds/recompute-group-standings.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "verify:football-schema": "node scripts/verify-football-schema.js"
  },
